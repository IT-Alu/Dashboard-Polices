# ============================================
# VARIABLES DE ENTORNO - CONTROL SEGUROS AAA
# ============================================
# 
# Copia este archivo a .env.local y rellena los valores
# con tus credenciales de Supabase.
#
# PASOS:
# 1. Ve a https://supabase.com y crea una cuenta
# 2. Crea un nuevo proyecto
# 3. En Project Settings > API, copia las credenciales
# 4. Pega los valores abajo

# URL de tu proyecto Supabase
# Ejemplo: https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=tu_project_url_aqui

# Clave anónima (anon/public key) de Supabase
# La encuentras en Project Settings > API > Project API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ============================================
# NOTAS IMPORTANTES
# ============================================
# - NUNCA subas el archivo .env.local a Git
# - El archivo .env.example SÍ se sube a Git
# - Las variables NEXT_PUBLIC_ son seguras en frontend
# - Supabase RLS protege los datos en backend